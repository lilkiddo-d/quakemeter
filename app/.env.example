# Quakemeter app — all variables are optional. Copy to .env.local for local development.

# Target chain: 4663 = Robinhood Chain mainnet (default), 31337 = local anvil fork of Robinhood Chain.
NEXT_PUBLIC_CHAIN_ID=4663

# Optional RPC override. Defaults: 4663 -> rpcUrls[0] from config/chains.json, 31337 -> http://127.0.0.1:8545
NEXT_PUBLIC_RPC_URL=

# Optional WalletConnect Cloud project id. Empty = injected browser wallets only (no WalletConnect).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Address of the externally launched $QUAK token. Empty = all token features (Stake page, fee discounts) hidden.
NEXT_PUBLIC_PROJECT_TOKEN=

# Optional comma-separated ISO-3166 alpha-2 country codes to geoblock (uses Vercel's x-vercel-ip-country header).
# Example: US,CU,IR,KP,SY   Empty = no geoblock. /risk and /blocked stay reachable.
NEXT_PUBLIC_GEOBLOCK_COUNTRIES=
